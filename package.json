{
  "name": "ai-voice-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Trilingual AI support worker: Twilio Media Streams -> STT -> LLM -> TTS with live transcripts and structured post-call notes.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude \"test/e2e/**\"",
    "test:e2e": "vitest run test/e2e",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "bakeoff": "tsx --env-file-if-exists=.env scripts/bakeoff/run.ts",
    "conformance": "tsx --env-file-if-exists=.env scripts/conformance/run.ts",
    "fixtures": "tsx scripts/gen-fixtures.ts"
  },
  "dependencies": {
    "@fastify/basic-auth": "^6.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "ajv": "^8.20.0",
    "fastify": "^5.0.0",
    "kysely": "^0.28.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "ws": "^8.18.0",
    "yaml": "^2.9.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.13",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
