# ----------------------------------------------------------------------------
# ai-voice-agent configuration
# Copy to .env and fill in values. Every model/provider reference below can be
# overridden without code changes. A JSON config file (CONFIG_FILE=./config.json)
# can also provide any of these values; environment variables win.
# ----------------------------------------------------------------------------

# --- Server -------------------------------------------------------------------
PORT=3000
# Public https base URL used in TwiML <Connect><Stream> (e.g. https://abc123.ngrok.io)
PUBLIC_BASE_URL=
LOG_LEVEL=info

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgres://voice:voice@localhost:5432/voice

# --- Dev browser calls (no Twilio needed) --------------------------------------
# WARNING: dev feature only. Enables /dev/call page + /media/browser WebSocket.
DEV_BROWSER_CALLS=false
# Fake caller number used for browser-originated sessions
DEV_FAKE_CALLER_NUMBER=+37200000000

# --- Twilio --------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Path of the bidirectional media WebSocket (referenced from TwiML)
TWILIO_MEDIA_WS_PATH=/media/twilio

# --- STT (speech to text) -------------------------------------------------------
# scribe | soniox | gladia
STT_PROVIDER=scribe
STT_MODEL=scribe_v2_realtime

# --- TTS (text to speech) -------------------------------------------------------
# elevenlabs | azure
TTS_PROVIDER=elevenlabs
# ElevenLabs model id (Eleven v3 covers et/ru/en; Flash v2.5 does NOT cover Estonian)
TTS_MODEL=eleven_v3
# Voice id per language (must support the language!)
TTS_VOICE_ET=pqHfZKP75CvOlQylNhV4
TTS_VOICE_RU=pFZP5JQG7iQjIQuC4Bku
TTS_VOICE_EN=21m00Tcm4TlvDq8ikWAM

# --- Voice provider API keys -----------------------------------------------------
ELEVENLABS_API_KEY=
# Only needed for the STT bake-off / alternative providers
SONIOX_API_KEY=
GLADIA_API_KEY=
# Fallback TTS provider (Azure neural voices)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- LLM (OpenRouter, OpenAI-compatible) -----------------------------------------
OPENROUTER_API_KEY=
# OpenAI-compatible base URL (swap for any compatible gateway)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model per role (OpenRouter model ids)
LLM_CONVERSATION_MODEL=openai/gpt-4o-mini
LLM_SUMMARIZER_MODEL=openai/gpt-4o-mini
LLM_UTILITY_MODEL=openai/gpt-4o-mini
# Optional per-language overrides for the conversation role
LLM_CONVERSATION_MODEL_ET=
LLM_CONVERSATION_MODEL_RU=
LLM_CONVERSATION_MODEL_EN=

# --- Admin console ----------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=
